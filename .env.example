# Copia este archivo a .env y rellena los valores. .env nunca se sube a git.
# Desarrollo local: db/setup-local.sh crea el rol y la base usando esta contraseña.
DATABASE_URL="postgresql://devlingo_app:CAMBIA_ESTA_CONTRASENA@localhost:5432/devlingo?schema=public"
# URL pública de la app (en producción, el dominio https de Cloudflare Tunnel).
APP_URL="http://localhost:3000"
# Solo en producción detrás de Cloudflare Tunnel: header con la IP real del cliente.
# Déjalo vacío/sin definir en desarrollo.
