# Copia este archivo a .env y rellena los valores. .env nunca se sube a git.
# Desarrollo local: db/setup-local.sh crea el rol y la base usando esta contraseña.
DATABASE_URL="postgresql://devlingo_app:CAMBIA_ESTA_CONTRASENA@localhost:5432/devlingo?schema=public"
# URL pública de la app (en producción, la URL https de Tailscale Funnel: https://devlingo.<tailnet>.ts.net).
APP_URL="http://localhost:3000"
# Solo en producción, y solo después de verificar el proxy (DEPLOY.md, paso 9):
# header con la IP real del cliente. Déjalo sin definir en desarrollo.
# TRUSTED_PROXY_HEADER="x-forwarded-for"
# Seed (solo producción): la cuenta admin inicial.
# SEED_ADMIN_EMAIL="tu-correo@ejemplo.com"
# SEED_ADMIN_NAME="Tu nombre"
